# Copy to backend/.env (local) or set these in your host's environment settings.
# backend/.env is git-ignored. Never commit a real key.

# --- Meta Model API (https://dev.meta.ai/docs/quickstart) ---
MODEL_API_KEY=
# Paid calls are OFF unless this is true.
MODEL_LIVE_CALLS_ENABLED=false
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
MODEL_TIMEOUT_SECONDS=45
# Per-request ceiling, counting visible output and reasoning tokens (minimum 16).
MODEL_MAX_OUTPUT_TOKENS=8000

# --- Browser access ---
# Comma-separated exact origins of the deployed frontend (scheme + host, no path, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cost protection for a public demo (0 disables) ---
RATE_LIMIT_PER_MINUTE=10
DAILY_ANALYSIS_LIMIT=300
MAX_BODY_BYTES=131072

# Set to false to hide /docs and /openapi.json in production.
API_DOCS_ENABLED=true
